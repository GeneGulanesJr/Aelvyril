# Gateway environment (Phase 2+).
# Copy to `.env` and fill in real values. Without CLERK_SECRET_KEY the only
# auth option is the dev verifier (PI_FAKE=1): it accepts ANY bearer token
# and is therefore refused on non-loopback GATEWAY_HOST values.
#
# This file lists every env var the gateway actually reads (src/index.ts +
# src/env.ts helpers, src/spec-heuristic.ts, src/health.ts, src/child-env.ts,
# fixtures/fake-pi.mjs). Commented entries are optional; quoted defaults
# match the startup log in src/index.ts.

# --- Auth (required in prod) ---
# Real Clerk secret key from https://dashboard.clerk.com → API Keys.
CLERK_SECRET_KEY=sk_test_placeholder
# #85: pin the token azp to the expected origins (comma-separated). Unset =
# Clerk's default azp verification.
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://app.example.com

# --- Server ---
# TCP port. Default 8787 (matches root README and apps/web defaults).
GATEWAY_PORT=8787
# Listen host. Default "::" (dual-stack, accepts IPv4-mapped) with real
# auth; 127.0.0.1 when the PI_FAKE dev verifier is active (#78 — the fake
# verifier refuses to boot on a non-loopback host). Override to "127.0.0.1"
# if your host has IPv6 disabled.
GATEWAY_HOST=::
# SQLite path for conversations + event log (WAL). Relative to CWD unless absolute.
GATEWAY_DB=./data/gateway.db
# Idle reap timeout for session-host child processes (ms).
GATEWAY_IDLE_MS=300000

# --- CORS ---
# Comma-separated list of origins allowed to call /v1/*. The web dev origin
# (http://localhost:3000) is the only one v1 needs.
GATEWAY_ALLOWED_ORIGIN=http://localhost:3000

# --- Admin (#76) ---
# Comma-separated Clerk user ids allowed to call /v1/admin/* (update
# status/apply — the apply route restarts the gateway and pulls origin/main).
# Default-deny: unset, NOBODY can call /v1/admin/*.
# GATEWAY_ADMIN_USER_IDS=user_2abc,user_3def

# --- Session host ---
# PI_FAKE=1 spawns fixtures/fake-pi.mjs (no pi binary required) AND enables
# the dev auth verifier when CLERK_SECRET_KEY is unset: any bearer token is
# accepted, userId = token. #78: commented out by default — uncomment ONLY
# for local development; the gateway will refuse to boot fake mode on a
# non-loopback GATEWAY_HOST.
# PI_FAKE=1
# #78 container ack: allows the fake verifier on a non-loopback GATEWAY_HOST
# (set by infra/compose.yaml, whose published ports are loopback-only).
# PI_FAKE_ALLOW_NON_LOOPBACK=1
# Command to spawn for the session host. Default: `pi`. Override only if the
# binary lives outside $PATH.
# PI_COMMAND=pi
# Optional JSON array of extra args to pass to PI_COMMAND. Use this on Windows
# where Node's spawn cannot exec .cmd/.ps1 shims — point PI_COMMAND at node.exe
# and put the cli.js path here:
# PI_COMMAND=C:\\Program Files\\nodejs\\node.exe
# PI_COMMAND_ARGS=["C:\\path\\to\\pi\\out\\cli.js"]
# Provider/model pinned at spawn (spec §14 — always explicit).
# PI_PROVIDER=google
# PI_MODEL=gemini-2.0-flash
# Fake-child fixture knobs (fake-pi.mjs; only these pass the child env
# allowlist in fake mode):
# FAKE_SPEC_QUESTIONS=1
#   first prompt → custom_spec_question, end turn
# FAKE_PLAN_JSON=[...]
#   draft plan for the custom_spec_draft signal
# FAKE_GATED_TOOL=1
#   execution turn starts with a bash `rm -rf` call
# FAKE_EDIT_FILE=path
#   execution turn writes this file (relative to cwd)
# FAKE_UI_DIALOG=1
#   opt-in blocking dialog (needs-you state)
# FAKE_DELAY_MS=5
#   per-message delay, ms

# --- Workspace allowlist (Spec §10) ---
# Comma-separated ABSOLUTE paths to curated workspaces a user may bind a
# conversation to. Default = empty (no workspaces allowed — deny by default).
# Conversations created without a workspace are always allowed (platform-level
# chats). Relative paths and `..` traversal are rejected at parse time.
# Example: GATEWAY_WORKSPACE_ALLOWLIST=/home/repo1,/home/repo2
# GATEWAY_WORKSPACE_ALLOWLIST=

# --- Logging (Spec §11) ---
# Pino (bundled with Fastify) emits structured JSON logs. Default ON.
# Set to "silent" in dev for a clean terminal.
# GATEWAY_LOG=silent

# --- Health probes (Spec §9) ---
# Backing-service URLs TCP-probed by /healthz (returns 503 on probe
# failure). Empty by default: unset probes are skipped, so a bare `pnpm
# start` still gets a clean 200. infra/compose.yaml sets LAYAMCP_URL.
# LAPIS_URL=http://127.0.0.1:8788
# SANDD_URL=http://127.0.0.1:7391
# LAYAMCP_URL=http://127.0.0.1:8765

# --- LLM provider keys (forwarded to pi children at spawn time) ---
# Never logged and blocked from GATEWAY_*/CLERK_* leakage into children;
# only this allowlist crosses the boundary (src/child-env.ts).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=

# --- SSE (Spec §6 keepalive + #85 caps) ---
# SSE heartbeat ping interval in ms. Default 15000. Lower it if your
# reverse proxy / load balancer times out idle connections; raise it to
# reduce wakeups on long-lived streams.
# SSE_HEARTBEAT_MS=15000
# Concurrent SSE streams per user (each holds a bus listener + heartbeat
# timer). Default 10; beyond the cap the connect is rejected.
# GATEWAY_MAX_SSE_STREAMS=10
# Replay page size for Last-Event-ID reconnects. Default 500.
# GATEWAY_SSE_REPLAY_PAGE=500
# Per-thread event-log retention (rows). Default 10000; 0 disables retention.
# GATEWAY_EVENT_RETENTION=10000

# --- Metrics (#85) ---
# /metrics is fail-closed: without either setting below it answers 401.
# Bearer secret for metric scrapes (constant-time compare):
# GATEWAY_METRICS_SECRET=
# Opt-in for LOCAL ONLY: serve /metrics with no secret at all.
# GATEWAY_METRICS_PUBLIC=1

# --- Abuse + long-horizon caps (Spec §10, #83, #84, Review P3) ---
# Per-user rate limit on /v1/conversations/:id/prompt. Default: 20 req/min/user
# (token bucket, capacity 20, refill 20/60 tokens/sec). On exceed: HTTP 429
# with `retry-after: 60`.
# GATEWAY_RATE_LIMIT_PER_MIN=20
# Per-user total-thread cap (renamed from the never-implemented
# GATEWAY_MAX_CONVERSATIONS_PER_USER). Default 30. On exceed: HTTP 503 with
# `{error: "conversation_limit_reached", limit: 30}`. Delete old threads to
# free space — rows are cheap; the host caps below are the real limit (#83).
# GATEWAY_MAX_THREADS=30
# Concurrent running session hosts per user. Default 2.
# GATEWAY_MAX_RUNNING_HOSTS=2
# Session hosts across all threads per user (resume ceiling). Default 100.
# GATEWAY_MAX_SESSION_HOSTS=100
# Per-thread budget in USD (#84): cost cap → blocked + refused prompts.
# Unset = no cost cap.
# GATEWAY_MAX_THREAD_COST_USD=5.00
# Delay between queued prompt dispatches (ms). Default 2000.
# GATEWAY_QUEUE_INTERVAL_MS=2000

# --- Spec contract / autonomy (issues #80 #81, ADR-0006) ---
# Bounded question budget per spec interview. Default 3 rounds; past the
# budget the agent is told to proceed on best judgment.
# GATEWAY_SPEC_MAX_ROUNDS=3
# Merges-without-revision at which a namespace's autonomy escalates to
# "established": external actions (installs, migrations) stop requiring
# approval. Irreversible actions (deletes, pushes, deploys) always gate.
# Default 5; 0 disables escalation.
# GATEWAY_TRUST_THRESHOLD=5
# Spec-interview kill switch (src/spec-heuristic.ts): only "off" is special —
# it forces auto mode to never trigger. Any other value (including "force",
# which is a per-request mode, not an env setting) behaves as auto.
# GATEWAY_SPEC_HEURISTIC=off
# extension_ui_request handling: "auto-responder" (default) or "blocked"
# (escalate blocking dialogs to the needs-you state).
# GATEWAY_DIALOG_MODE=blocked

# --- Auto-verify loop (issue #82, ADR-0006) ---
# After an execution settles with edits the gateway runs the workspace's
# verify commands, feeds failures back to the agent (bounded retries), and
# escalates to the user only with failure context attached. Set 0 to
# disable entirely.
# GATEWAY_VERIFY=1
# Override auto-detection (workspace package.json test/lint/typecheck
# scripts) with an explicit comma-separated command list.
# GATEWAY_VERIFY_COMMANDS=pnpm test,pnpm lint,pnpm typecheck
# Bounded self-retry budget before escalating to the user. Default 3.
# GATEWAY_VERIFY_RETRIES=3
# Per-command timeout (ms). Default 300000 (5 min).
# GATEWAY_VERIFY_TIMEOUT_MS=300000
