# infra/.env — compose interpolation template for the Aelvyril stack.
# Copy to infra/.env: docker compose auto-loads that file (same directory
# as compose.yaml) for every ${VAR} referenced in the YAML, and
# infra/smoke.sh sources it for its preflight. Every name below appears
# verbatim in infra/compose.yaml interpolation (compose.hardened.yaml adds
# none) — nothing here is invented. The gateway's strict env parsing
# (apps/gateway/src/env.ts) treats an empty string as unset, so leaving an
# entry empty selects the code default.
#
# Per-var semantics: apps/gateway/.env.example (gateway), infra/README.md
# (topology, prod TLS walkthrough).

# --- Domain + TLS (caddy service, prod profile) ---
# Let's Encrypt cert subject (ACME). Default "localhost".
AELVYRIL_DOMAIN=localhost
# #79: Clerk Frontend-API origins added to the CSP's script-src +
# connect-src (space-separated; include BOTH the https:// and wss://
# spellings, e.g. "https://clerk.acmeinc.com wss://clerk.acmeinc.com").
# Empty = self-only CSP, which blocks Clerk sign-in — set in prod from
# your Clerk dashboard (API Keys → Frontend API).
CSP_CLERK_ORIGINS=

# --- Web (build-time args + runtime) ---
# NEXT_PUBLIC_* is inlined into the client bundle at BUILD time. Dev
# default http://localhost:8787 (loopback-published gateway); prod: set to
# EMPTY for same-origin /v1/* via the Caddy route (compose keeps a
# set-but-empty value — it interpolates with `-${...}` for this var).
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787
# Publishable key, baked into the browser bundle. Empty = Clerk sign-in
# dead-ends unless NEXT_PUBLIC_AUTH_DISABLED=1.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Build-time auth switch: 1 = no Clerk sign-in, fixed dev identity.
NEXT_PUBLIC_AUTH_DISABLED=
# Host interface for the loopback-only web 3000 publication (#79).
WEB_BIND_HOST=127.0.0.1
# Web runtime (SSR) Clerk key. Kept distinct from the gateway's
# CLERK_SECRET_KEY below.
WEB_CLERK_SECRET_KEY=

# --- Gateway (host publication + core) ---
# Host interface for the loopback-only gateway 8787 publication (#79).
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated ABSOLUTE paths; empty = deny all workspaces (Spec §10).
GATEWAY_WORKSPACE_ALLOWLIST=
# Real Clerk secret key for bearer verification. Empty requires PI_FAKE=1
# for the dev verifier.
CLERK_SECRET_KEY=

# --- Gateway operator passthrough (caps + gating) ---
# Read in apps/gateway/src (index.ts, spec-heuristic.ts). Empty = unset =
# code defaults (see apps/gateway/.env.example). Without
# GATEWAY_ADMIN_USER_IDS the /v1/admin/* routes 403 for everyone; /metrics
# stays fail-closed 401 until GATEWAY_METRICS_SECRET is set or
# GATEWAY_METRICS_PUBLIC=1.
GATEWAY_ADMIN_USER_IDS=
GATEWAY_METRICS_SECRET=
GATEWAY_METRICS_PUBLIC=
CLERK_AUTHORIZED_PARTIES=
GATEWAY_MAX_THREADS=
GATEWAY_MAX_RUNNING_HOSTS=
GATEWAY_MAX_SESSION_HOSTS=
GATEWAY_MAX_SSE_STREAMS=
GATEWAY_SSE_REPLAY_PAGE=
GATEWAY_EVENT_RETENTION=
GATEWAY_MAX_THREAD_COST_USD=
GATEWAY_QUEUE_INTERVAL_MS=
GATEWAY_DIALOG_MODE=
GATEWAY_SPEC_HEURISTIC=
GATEWAY_VERIFY=
GATEWAY_RATE_LIMIT_PER_MIN=
GATEWAY_SPEC_MAX_ROUNDS=
GATEWAY_TRUST_THRESHOLD=
GATEWAY_VERIFY_TIMEOUT_MS=
GATEWAY_VERIFY_RETRIES=
GATEWAY_VERIFY_COMMANDS=
SSE_HEARTBEAT_MS=

# --- Session host (pi) ---
# Local dev: PI_FAKE=1 swaps the auth verifier (any bearer; token = userId)
# and the pi child (fixtures/fake-pi.mjs). PI_FAKE_ALLOW_NON_LOOPBACK=1 is
# the #78 container ack (compose binds GATEWAY_HOST="::" in-container while
# published ports stay loopback-only).
PI_FAKE=
PI_FAKE_ALLOW_NON_LOOPBACK=
# Spec §14: always pass --provider/--model explicitly.
PI_PROVIDER=google
PI_MODEL=gemini-2.0-flash

# --- LLM provider keys (flow to pi children at spawn time) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Workspaces bind mount ---
# Host path mounted at /workspaces in the gateway (WRITABLE: the pi agent
# edits files + session state, auto-verify runs test scripts — the
# GATEWAY_WORKSPACE_ALLOWLIST is the trust boundary). Created on first
# `up`; gitignored.
WORKSPACES_HOST_PATH=./workspaces

# --- pi CLI version (build ARG — NOT wired through compose) ---
# Dockerfile.gateway ARG, default 1.0.4. Setting it here does nothing
# unless you also add it to the gateway `build.args` in compose.yaml.
# PI_CLI_VERSION=1.0.4

# --- Local smoke (uncomment for infra/smoke.sh) ---
# Preflight requires NEXT_PUBLIC_AUTH_DISABLED=1 + PI_FAKE=1 in this file
# (no real keys needed); with PI_FAKE=1 and no CLERK_SECRET_KEY it also
# requires the #78 container ack:
# NEXT_PUBLIC_AUTH_DISABLED=1
# PI_FAKE=1
# PI_FAKE_ALLOW_NON_LOOPBACK=1
