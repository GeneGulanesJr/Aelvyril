# Spec §11: TLS termination in front of web.
#
# Caddy auto-provisions Let's Encrypt certs via ACME (no manual renewal).
# Set AELVYRIL_DOMAIN (e.g., aelvyril.example.com) and Caddy will request
# a cert on first boot. Certs + account keys persist in the caddy-data
# volume so restarts don't re-request.
#
# In dev (no public DNS), set AELVYRIL_DOMAIN to localhost and Caddy
# falls back to its internal CA (the ondemand tls policy is skipped).
# Override the caddy_image + log level via env if needed.

{$AELVYRIL_DOMAIN:localhost} {
    encode gzip zstd
    reverse_proxy web:3000

    # Expose /metrics over TLS too (optional — gated by your scraper's
    # network policy). Uncomment to enable.
    # @metrics header X-Scrape-Secret {http.request.header.X-Scrape-Secret}
    # handle @metrics {
    #     reverse_proxy gateway:8787 {
    #         header_up Host {host}
    #     }
    # }
    # handle /metrics {
    #     respond 403
    # }

    # HSTS (1 year, include subdomains). Only meaningful over HTTPS.
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Security headers — apply to all responses.
    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "strict-origin-when-cross-origin"
}
