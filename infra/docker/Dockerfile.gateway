# Spec §9: Node 22 + pi CLI + baked ~/.pi/agent (LaPis + PiSubagent extensions,
# project agents, settings.json with layamcp MCP server). The supervisor
# spawns `pi --mode rpc` children at runtime; the binary + agent bundle must
# be present in the image.
#
# Build context: Aelvyril repo root.

FROM node:22-slim AS deps
WORKDIR /repo
# better-sqlite3 (gateway runtime dep) builds from source under pnpm 10's
# onlyBuiltDependencies — node:22-slim ships no compiler toolchain.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
# tsconfig.base.json: workspace tsconfigs (and tsx) extend/read it.
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY apps/gateway/package.json ./apps/gateway/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm fetch --prod=false
COPY apps/gateway ./apps/gateway
COPY packages/shared ./packages/shared
RUN pnpm install --frozen-lockfile --offline --prod=false
# Shared builds for real — a silent failure would ship a stale/missing wire
# contract. Assert the build script exists, then run it unmasked.
RUN node -e "process.exit(require('./packages/shared/package.json').scripts?.build ? 0 : 1)" \
    && pnpm --filter @aelvyril/shared build

FROM node:22-slim AS runtime
ENV NODE_ENV=production \
    GATEWAY_PORT=8787 \
    GATEWAY_HOST=:: \
    LAPIS_HOME=/data/lapis
# pi is published to npm; we install it into the image so the supervisor's
# PI_COMMAND=pi can spawn it. Spec §6: pi must be on PATH in the image.
# NOTE: the real CLI is @earendil-works/pi-coding-agent (bin: `pi`) — the
# historical @mariozechner/pi name installs an unrelated `pi-pods` bin.
# Pinned for reproducible builds (review P2) — bump deliberately.
ARG PI_CLI_VERSION=1.0.4
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate \
    && npm install -g "@earendil-works/pi-coding-agent@${PI_CLI_VERSION}" \
    && which pi && pi --version
# The baked ~/.pi/agent directory is operator-provided: copy from build
# context if present. Missing-by-default is fine; the gateway's PI_FAKE=1
# fallback uses fixtures/fake-pi.mjs for local dev. For real mode, the
# operator mounts a populated ~/.pi/agent as a volume or layers it in.
COPY --from=deps /repo /repo
WORKDIR /repo/apps/gateway
# Non-root per spec §9.
RUN groupadd --gid 1001 nodejs \
    && useradd --uid 1001 --gid nodejs --shell /bin/bash --create-home gateway \
    && mkdir -p /data /sessions \
    && chown -R gateway:nodejs /data /sessions /repo
USER gateway
EXPOSE 8787
# --env-file-if-exists loads apps/gateway/.env if mounted; the operator
# supplies real Clerk keys + provider keys at deploy time.
CMD ["node", "--env-file-if-exists=/repo/apps/gateway/.env", "--import", "tsx", "/repo/apps/gateway/src/index.ts"]
